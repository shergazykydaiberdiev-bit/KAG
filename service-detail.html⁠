<!DOCTYPE html>
<html lang="ky">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KAG — Кызмат</title>
    <link rel="stylesheet" href="style.css">
    <style>
        .service-detail-page {
            max-width: 1100px;
            margin: 0 auto;
            padding: 60px 20px 120px;
        }
        .back-link {
            display: inline-block;
            margin-bottom: 25px;
            color: #D4AF37;
            text-decoration: none;
        }
        .service-detail-card {
            display: grid;
            grid-template-columns: 1.4fr 0.8fr;
            gap: 35px;
        }
        .service-main,
        .service-order-box {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(212,175,55,0.18);
            border-radius: 24px;
            padding: 30px;
        }
        .service-big-icon {
            font-size: 70px;
            margin-bottom: 15px;
        }
        .service-detail-category {
            color: #D4AF37;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .service-main h1 {
            font-size: 42px;
            margin: 10px 0;
        }
        .service-description {
            opacity: 0.8;
            line-height: 1.7;
            font-size: 17px;
        }
        .service-features {
            margin-top: 30px;
        }
        .service-features div {
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .order-price {
            font-size: 30px;
            color: #D4AF37;
            font-weight: 800;
            margin: 20px 0;
        }
        .order-label {
            display: block;
            margin-top: 18px;
            margin-bottom: 7px;
            opacity: 0.8;
        }
        .order-input {
            width: 100%;
            box-sizing: border-box;
            padding: 14px;
            border-radius: 12px;
            border: 1px solid rgba(212,175,55,0.25);
            background: rgba(0,0,0,0.2);
            color: inherit;
            font-size: 15px;
        }
        .order-button {
            width: 100%;
            margin-top: 25px;
            padding: 16px;
            border: 0;
            border-radius: 12px;
            background: #D4AF37;
            color: #06251B;
            font-size: 16px;
            font-weight: 800;
            cursor: pointer;
        }
        .order-button:hover {
            opacity: 0.9;
        }
        .secure-note {
            margin-top: 15px;
            text-align: center;
            font-size: 13px;
            opacity: 0.65;
        }
        @media (max-width: 800px) {
            .service-detail-card {
                grid-template-columns: 1fr;
            }
            .service-main h1 {
                font-size: 32px;
            }
        }
    </style>
</head>
<body>
<header class="kag-header">
    <div class="header-inner">
        <a href="index.html" class="kag-logo">
            KAG
        </a>
        <nav class="desktop-nav">
            <a href="index.html">
                Башкы бет
            </a>
            <a href="marketplace.html" class="active">
                Кызматтар
            </a>
            <a href="tickets.html">
                Tickets
            </a>
            <a href="cart.html">
                🛒 Корзина
                <span id="cartCount">0</span>
            </a>
            <a href="orders.html">
                📦 Заказдар
            </a>
            <a href="profile.html">
                Профиль
            </a>
        </nav>
        <a href="login.html" class="login-btn">
            Кирүү
        </a>
    </div>
</header>
<main class="service-detail-page">
    <a href="marketplace.html" class="back-link">
        ← Кызматтарга кайтуу
    </a>
    <div class="service-detail-card">
        <!-- SERVICE INFORMATION -->
        <section class="service-main">
            <div
                id="serviceIcon"
                class="service-big-icon">
                🛠️
            </div>
            <span
                id="serviceCategory"
                class="service-detail-category">
                KAG SERVICE
            </span>
            <h1 id="serviceTitle">
                Кызмат
            </h1>
            <p
                id="serviceDescription"
                class="service-description">
                Кызмат тууралуу маалымат.
            </p>
            <div class="service-features">
                <div>
                    ✓ Текшерилген аткаруучулар
                </div>
                <div>
                    ✓ Бааны алдын ала билесиз
                </div>
                <div>
                    ✓ KAG аркылуу коопсуз заказ
                </div>
                <div>
                    ✓ Заказдан кийин рейтинг калтыра аласыз
                </div>
            </div>
        </section>
        <!-- ORDER -->
        <aside class="service-order-box">
            <span>
                Баштапкы баа
            </span>
            <div
                id="servicePrice"
                class="order-price">
                1 000 сом
            </div>
            <label
                class="order-label"
                for="customerAddress">
                Дарек
            </label>
            <input
                id="customerAddress"
                class="order-input"
                type="text"
                placeholder="Мисалы: Бишкек, Манас 10">
            <label
                class="order-label"
                for="customerDate">
                Дата
            </label>
            <input
                id="customerDate"
                class="order-input"
                type="date">
            <label
                class="order-label"
                for="customerNote">
                Кошумча маалымат
            </label>
            <textarea
                id="customerNote"
                class="order-input"
                rows="4"
                placeholder="Тапшырма тууралуу кошумча маалымат..."></textarea>
            <button
                class="order-button"
                onclick="addServiceToCart()">
                Заказ берүү →
            </button>
            <div class="secure-note">
                🔒 KAG Secure Order
            </div>
        </aside>
    </div>
</main>
<nav class="mobile-bottom-nav">
    <a href="index.html">
        <span>⌂</span>
        <small>Башкы бет</small>
    </a>
    <a href="marketplace.html" class="active">
        <span>⌕</span>
        <small>Кызматтар</small>
    </a>
    <a href="cart.html">
        <span>🛒</span>
        <small>Корзина</small>
    </a>
    <a href="orders.html">
        <span>▣</span>
        <small>Заказдар</small>
    </a>
    <a href="profile.html">
        <span>◯</span>
        <small>Профиль</small>
    </a>
</nav>
<script>
    const services = {
        plumbing: {
            title: "Сантехник",
            category: "Ремонт",
            icon: "🔧",
            price: 1000,
            description:
                "Суу түтүктөрүн, крандарды, раковиналарды жана башка сантехникалык иштерди аткаруу."
        },
        cleaning: {
            title: "Үй тазалоо",
            category: "Тазалоо",
            icon: "🧹",
            price: 800,
            description:
                "Батирлерди, үйлөрдү жана кеңселерди профессионалдуу тазалоо кызматы."
        },
        electrician: {
            title: "Электрик",
            category: "Ремонт",
            icon: "⚡",
            price: 1000,
            description:
                "Розетка, жарык, электр зымдары жана башка электр иштерин аткаруу."
        },
        delivery: {
            title: "Курьер",
            category: "Жеткирүү",
            icon: "🚚",
            price: 300,
            description:
                "Документтерди, товарларды жана башка буюмдарды тез жеткирүү."
        },
        construction: {
            title: "Курулуш мастери",
            category: "Курулуш",
            icon: "🏗️",
            price: 2000,
            description:
                "Курулуш, ремонт жана монтаж иштерин профессионалдуу аткаруу."
        },
        it: {
            title: "IT кызматтары",
            category: "IT & Digital",
            icon: "💻",
            price: 1000,
            description:
                "Сайт түзүү, компьютер, программа жана башка digital кызматтар."
        }
    };
    const params =
        new URLSearchParams(
            window.location.search
        );
    const serviceKey =
        params.get("service") || "plumbing";
    const service =
        services[serviceKey] || services.plumbing;
    document.getElementById(
        "serviceIcon"
    ).textContent = service.icon;
    document.getElementById(
        "serviceCategory"
    ).textContent = service.category;
    document.getElementById(
        "serviceTitle"
    ).textContent = service.title;
    document.getElementById(
        "serviceDescription"
    ).textContent = service.description;
    document.getElementById(
        "servicePrice"
    ).textContent =
        service.price.toLocaleString("ru-RU") +
        " сом";
    function addServiceToCart() {
        const address =
            document.getElementById(
                "customerAddress"
            ).value.trim();
        const date =
            document.getElementById(
                "customerDate"
            ).value;
        const note =
            document.getElementById(
                "customerNote"
            ).value.trim();
        if (!address) {
            alert(
                "Сураныч, даректи жазыңыз."
            );
            return;
        }
        if (!date) {
            alert(
                "Сураныч, датаны тандаңыз."
            );
            return;
        }
        const item = {
            id: Date.now(),
            service: service.title,
            category: service.category,
            price: service.price,
            address: address,
            date: date,
            note: note,
            quantity: 1
        };
        let cart =
            JSON.parse(
                localStorage.getItem(
                    "kagCart"
                )
            ) || [];
        cart.push(item);
        localStorage.setItem(
            "kagCart",
            JSON.stringify(cart)
        );
        window.location.href =
            "checkout.html";
    }
    function updateCartCount() {
        const cart =
            JSON.parse(
                localStorage.getItem(
                    "kagCart"
                )
            ) || [];
        const counter =
            document.getElementById(
                "cartCount"
            );
        if (counter) {
            counter.textContent =
                cart.length;
        }
    }
    updateCartCount();
</script>
</body>
</html>
